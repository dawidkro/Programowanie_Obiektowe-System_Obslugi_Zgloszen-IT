{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Zbuduj i uruchom",
      "type": "shell",
      "command": "g++ -std=c++17 -Wall -Iinclude (Get-ChildItem src\\*.cpp).FullName -o helpdesk.exe; if ($?) { .\\helpdesk.exe }",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "focus": true, "panel": "shared", "clear": true }
    }
  ]
}
